# Frontend environment variables
# Copy this file to .env and adjust values as needed.

# Optional: Override the weather API base URL
# If not set, the app uses free, keyless Open-Meteo endpoints by default.
REACT_APP_API_BASE=

# Optional: Weather API key if your chosen provider requires it.
# We do NOT recommend committing real secrets. This is a placeholder.
REACT_APP_WEATHER_API_KEY=
